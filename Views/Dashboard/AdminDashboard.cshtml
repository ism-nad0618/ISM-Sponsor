@model ISMSponsor.ViewModels.AdminDashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <h1>Admin Dashboard</h1>
    <p class="page-subtitle">
        System overview for school year: <strong>@(Model.SelectedSchoolYear?.Name ?? "Not Selected")</strong>
    </p>
</div>

@if (Model.Alerts?.Any() == true)
{
    @await Html.PartialAsync("_DashboardAlerts", Model.Alerts)
}

<div class="stat-grid">
    <a href="/Settings/Sponsors" class="stat-card" style="text-decoration: none; color: inherit; cursor: pointer;">
        <div class="stat-label">Active Sponsors</div>
        <div class="stat-value">@Model.ActiveSponsors</div>
        <div class="stat-sub">@(Model.TotalSponsors - Model.ActiveSponsors) inactive</div>
    </a>
    <div class="stat-card">
        <div class="stat-label">Total Students</div>
        <div class="stat-value">@Model.TotalStudents</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Active LoGs</div>
        <div class="stat-value">@Model.ActiveLoGs</div>
        <div class="stat-sub">of @Model.TotalLoGs total</div>
    </div>
    <div class="stat-card @(Model.PendingLoGs > 0 || Model.PendingChangeRequests > 0 ? "stat-card-warning" : "")">
        <div class="stat-label">Pending Items</div>
        <div class="stat-value">@(Model.PendingLoGs + Model.PendingChangeRequests)</div>
        <div class="stat-sub">@Model.PendingLoGs LoGs, @Model.PendingChangeRequests requests</div>
    </div>
</div>

<div class="card">
    <h2 class="table-title">Letters of Guarantee for Approval (@Model.RecentLoGs.Count())</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Sponsor</th>
                    <th>Status</th>
                    <th>Coverage</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentLoGs.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 2rem; color: var(--gray-500);">No LoGs awaiting approval.</td>
                    </tr>
                }
                else
                {
                    foreach (var log in Model.RecentLoGs)
                    {
                        var avgCoverage = log.CoverageRules?.Any() == true 
                            ? log.CoverageRules.Where(r => r.CoveragePercentage.HasValue).Average(r => r.CoveragePercentage) ?? 0
                            : 0;
                        <tr>
                            <td data-label="Student">@log.Student?.FirstName @log.Student?.LastName</td>
                            <td data-label="Sponsor">@log.Sponsor?.SponsorName</td>
                            <td data-label="Status">
                                <span class="status-badge @(log.LogStatus == "Approved" ? "status-active" : log.LogStatus == "Pending" ? "status-pending" : "status-draft")">
                                    @log.LogStatus
                                </span>
                            </td>
                            <td data-label="Coverage">@avgCoverage.ToString("F0")%</td>
                            <td data-label="Created">@log.CreatedOn.ToString("MMM d, yyyy")</td>
                            <td data-label="Actions" class="action-cell">
                                <a href="javascript:void(0)" onclick="openDetailsModal(@log.LogId)" class="btn-link">View</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<style>
.stat-card-warning {
    border-left: 4px solid #f59e0b;
}
.stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    transition: all 0.2s ease;
}
</style>

<!-- Details Modal -->
<div id="detailsModal" class="modal">
    <div class="modal-content" style="max-width: 900px;">
        <div class="modal-header">
            <h2 id="detailsModalTitle">Letter of Guarantee #<span id="detailsLogId"></span></h2>
            <button class="modal-close" onclick="closeDetailsModal()">&times;</button>
        </div>
        <div class="modal-body" id="detailsModalBody">
            @Html.AntiForgeryToken()
            <!-- Content will be loaded here via AJAX -->
        </div>
    </div>
</div>

<script>
// Details Modal Functions
async function openDetailsModal(logId) {
    const modal = document.getElementById('detailsModal');
    const modalBody = document.getElementById('detailsModalBody');
    const modalTitle = document.getElementById('detailsLogId');
    
    // Set the LoG ID in the header
    if (modalTitle) modalTitle.textContent = logId;
    
    // Preserve the antiforgery token
    const tokenInput = modalBody.querySelector('input[name="__RequestVerificationToken"]');
    const tokenHtml = tokenInput ? tokenInput.outerHTML : '';
    
    // Show loading state
    modalBody.innerHTML = tokenHtml + '<div style="text-align: center; padding: 2rem;"><p>Loading details...</p></div>';
    modal.style.display = 'flex';
    
    try {
        const response = await fetch(`/Settings/LetterOfGuarantee/DetailsModal/${logId}`);
        if (!response.ok) {
            throw new Error('Failed to load details');
        }
        
        const html = await response.text();
        modalBody.innerHTML = tokenHtml + html;
        
        // Initialize navigation buttons after content is loaded
        currentDetailsStep = 1;
        updateDetailsNavigationButtons();
    } catch (error) {
        console.error('Error:', error);
        modalBody.innerHTML = tokenHtml + '<div class="alert alert-error">Failed to load details. Please try again.</div>';
    }
}

function closeDetailsModal() {
    document.getElementById('detailsModal').style.display = 'none';
}

// Details Modal Navigation Functions
let currentDetailsStep = 1;
const totalDetailsSteps = 4;

function goToDetailsStep(step) {
    currentDetailsStep = step;
    
    // Hide all steps
    document.querySelectorAll('.step-content[data-modal="details"]').forEach(content => {
        content.style.display = 'none';
    });
    document.querySelectorAll('.step-tab[data-modal="details"]').forEach(tab => {
        tab.classList.remove('active');
    });
    
    // Show selected step
    const selectedContent = document.querySelector(`.step-content[data-modal="details"][data-step="${step}"]`);
    const selectedTab = document.querySelector(`.step-tab[data-modal="details"][data-step="${step}"]`);
    
    if (selectedContent) selectedContent.style.display = 'block';
    if (selectedTab) selectedTab.classList.add('active');
    
    // Update navigation buttons
    updateDetailsNavigationButtons();
}

function nextDetailsStep() {
    if (currentDetailsStep < totalDetailsSteps) {
        goToDetailsStep(currentDetailsStep + 1);
    }
}

function previousDetailsStep() {
    if (currentDetailsStep > 1) {
        goToDetailsStep(currentDetailsStep - 1);
    }
}

function updateDetailsNavigationButtons() {
    const prevBtn = document.getElementById('detailsPrevStepBtn');
    const nextBtn = document.getElementById('detailsNextStepBtn');
    const rejectBtn = document.getElementById('detailsRejectBtn');
    const approveBtn = document.getElementById('detailsApproveBtn');
    
    if (prevBtn) {
        prevBtn.style.display = currentDetailsStep === 1 ? 'none' : 'block';
    }
    
    if (nextBtn) {
        if (currentDetailsStep === totalDetailsSteps) {
            nextBtn.style.display = 'none';
            // Show approval buttons on last step if they exist
            if (rejectBtn) rejectBtn.style.display = 'flex';
            if (approveBtn) approveBtn.style.display = 'flex';
        } else {
            nextBtn.style.display = 'flex';
            nextBtn.style.flex = '1';
            if (rejectBtn) rejectBtn.style.display = 'none';
            if (approveBtn) approveBtn.style.display = 'none';
        }
    }
}

async function approveLogFromModal(logId) {
    if (!confirm('Approve this Letter of Guarantee? It will be automatically activated.')) {
        return;
    }
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    
    try {
        const formData = new FormData();
        formData.append('reviewComments', '');
        
        const response = await fetch(`/Settings/LetterOfGuarantee/Approve/${logId}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        });
        
        if (response.ok) {
            alert('Letter of Guarantee approved successfully!');
            closeDetailsModal();
            window.location.reload();
        } else {
            alert('Failed to approve. Please try again.');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('An error occurred. Please try again.');
    }
}

async function rejectLogFromModal(logId) {
    const reason = prompt('Please enter the reason for rejection:');
    if (!reason || reason.trim() === '') {
        alert('Rejection reason is required.');
        return;
    }
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    
    try {
        const formData = new FormData();
        formData.append('rejectionReason', reason);
        
        const response = await fetch(`/Settings/LetterOfGuarantee/Reject/${logId}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        });
        
        if (response.ok) {
            alert('Letter of Guarantee rejected successfully!');
            closeDetailsModal();
            window.location.reload();
        } else {
            alert('Failed to reject. Please try again.');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('An error occurred. Please try again.');
    }
}

// Close modal when clicking outside - DISABLED for Details modal
// Users must use the Close/Cancel button to exit
