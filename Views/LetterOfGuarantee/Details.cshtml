@model ISMSponsor.Models.Domain.LogCoverage
@{
    Layout = "_Layout";
    ViewData["Title"] = $"LoG #{Model.LogId} Details";
}

<style>
    .field-label { font-size: 0.8rem; margin-bottom: 0.25rem; }
    .data-grid > div p { font-size: 0.875rem; margin: 0; }
    .data-grid { gap: 0.75rem; }
    .card { padding: 0.75rem; margin-bottom: 0.75rem; }
    .table-title { font-size: 1rem; margin-bottom: 0.5rem; }
    .alert { padding: 0.5rem; font-size: 0.875rem; }
</style>

<div class="page-header" style="padding: 0.75rem 0; margin-bottom: 0.75rem;">
    <div class="page-header-actions">
        <div>
            <h1 style="font-size: 1.5rem; margin-bottom: 0.25rem;">Letter of Guarantee #@Model.LogId</h1>
            <p class="page-subtitle" style="font-size: 0.875rem; margin: 0;">Detailed view and activation management</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            <a asp-action="Coverage" asp-route-id="@Model.LogId" class="btn-primary btn-add">View Coverage Rules</a>
            @if (User.IsInRole("admin") || User.IsInRole("admissions"))
            {
                <a asp-action="Edit" asp-route-id="@Model.LogId" class="btn-secondary btn-add">Edit LoG</a>
            }
            <a asp-action="Index" class="btn-secondary btn-add">Back to List</a>
        </div>
    </div>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success">@successMsg</div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-error">@errorMsg</div>
}

<div class="card" style="padding: 0.75rem; margin-bottom: 0.75rem;">
    <h2 class="table-title" style="font-size: 1rem; margin-bottom: 0.5rem;">Status and Activation</h2>
    
    <div class="data-grid" style="margin-bottom: 0.75rem; gap: 0.75rem;">
        <div>
            <p class="field-label">Current Status</p>
            <p><span class="status-badge status-@Model.LogStatus.ToLower()">@Model.LogStatus</span></p>
        </div>
        <div>
            <p class="field-label">Activation State</p>
            <p>
                @if (Model.IsActive)
                {
                    <span class="status-badge status-active">Active</span>
                }
                else
                {
                    <span class="status-badge status-inactive">Inactive</span>
                }
            </p>
        </div>
    </div>

    @if (Model.IsActive && Model.ActivatedOn.HasValue)
    {
        <div class="alert alert-success" style="padding: 0.5rem; font-size: 0.875rem; margin-bottom: 0.75rem;">
            <strong>Active Coverage</strong> - Activated @Model.ActivatedOn?.ToString("MMM dd, yyyy")
            @if (Model.ActivatedByUser != null)
            {
                <text> by @Model.ActivatedByUser.DisplayName</text>
            }
        </div>
    }
    else if (Model.DeactivatedOn.HasValue)
    {
        <div class="alert alert-error" style="padding: 0.5rem; font-size: 0.875rem; margin-bottom: 0.75rem;">
            <strong>Deactivated</strong> - @Model.DeactivatedOn?.ToString("MMM dd, yyyy")
            @if (Model.DeactivatedByUser != null)
            {
                <text> by @Model.DeactivatedByUser.DisplayName</text>
            }
            @if (!string.IsNullOrEmpty(Model.DeactivationReason))
            {
                <text> | Reason: @Model.DeactivationReason</text>
            }
        </div>
    }

    @* Approval Workflow Actions *@
    @if (@Model.LogStatus == "Draft" && (User.IsInRole("admin") || User.IsInRole("admissions") || User.IsInRole("sponsor")))
    {
        <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--gray-200);">
            <p class="field-label" style="margin-bottom: 0.25rem; font-size: 0.875rem;">📤 Submit for Review</p>
            <form asp-action="Submit" asp-route-id="@Model.LogId" method="post" style="display: inline;">
                <button type="submit" class="btn-primary" onclick="return confirm('Submit this Letter of Guarantee for review? It will be forwarded to the Administrator.');" style="padding: 0.5rem 1rem;">
                    Submit for Admin Review
                </button>
            </form>
        </div>
    }
    else if (@Model.LogStatus == "Submitted" && User.IsInRole("admin"))
    {
        <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--gray-200);">
            <p class="field-label" style="margin-bottom: 0.5rem; font-size: 0.875rem;">👀 Admin Review Actions</p>
            
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <div style="flex: 1; min-width: 200px;">
                    <form asp-action="Approve" asp-route-id="@Model.LogId" method="post" id="approveForm">
                        <textarea id="approvalComments" name="reviewComments" rows="1" class="form-control" placeholder="Comments (optional)" style="margin-bottom: 0.5rem; width: 100%; font-size: 0.875rem;"></textarea>
                        <button type="submit" class="btn-primary" onclick="return confirm('Approve this Letter of Guarantee? It will be automatically activated.');" style="width: 100%; padding: 0.5rem 1rem;">
                            Approve & Activate
                        </button>
                    </form>
                </div>
                
                <div style="flex: 1; min-width: 200px;">
                    <button type="button" class="btn-danger" onclick="document.getElementById('rejectionModal').style.display='block';" style="width: 100%; padding: 0.5rem 1rem; margin-top: 1.65rem;">
                        Reject LoG
                    </button>
                </div>
            </div>
        </div>
    }
    else if (@Model.LogStatus == "Approved")
    {
        <div class="alert alert-success" style="margin-top: 0.75rem; padding: 0.5rem; font-size: 0.875rem;">
            <strong>✓ Approved & Active</strong> - This LoG has been approved and is currently active.
        </div>
    }
    else if (@Model.LogStatus == "Rejected")
    {
        <div class="alert alert-error" style="margin-top: 0.75rem; padding: 0.5rem; font-size: 0.875rem;">
            <strong>✕ Rejected</strong> - This LoG has been rejected. Review comments below.
        </div>
    }
    else if (@Model.LogStatus == "Submitted")
    {
        <div class="alert" style="margin-top: 0.75rem; padding: 0.5rem; font-size: 0.875rem; background: #fef3c7; color: #92400e; border-left: 4px solid #f59e0b;">
            <strong>⏳ Awaiting Admin Review</strong> - This LoG is waiting for administrator approval.
        </div>
    }

    @if (User.IsInRole("admin") && !Model.IsActive && Model.LogStatus == "Approved")
    {
        <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--gray-200);">
            <p class="field-label" style="margin-bottom: 0.5rem;">Admin Actions</p>
            @if (!Model.IsActive && Model.LogStatus == "Approved")
            {
                <p class="help-text" style="color: var(--gray-500); margin-bottom: 0.5rem;">LoG is already activated. Use Deactivate if needed.</p>
            }
            
            @if (Model.IsActive)
            {
                <button type="button" class="btn-danger" onclick="document.getElementById('deactivateModal').style.display='block';">
                     Deactivate LoG
                </button>
            }
        </div>
    }
</div>

<div class="card" style="padding: 0.75rem; margin-bottom: 0.75rem;">
    <h2 class="table-title" style="font-size: 1rem; margin-bottom: 0.5rem;">Student and Sponsor Information</h2>
    <div class="data-grid" style="gap: 0.75rem;">
        <div>
            <p class="field-label">School Year</p>
            <p><strong>@Model.SchoolYearId</strong></p>
        </div>
        <div>
            <p class="field-label">Student ID</p>
            <p><strong>@Model.StudentId</strong></p>
        </div>
        <div>
            <p class="field-label">Student Name</p>
            <p><strong>@(Model.Student != null ? $"{Model.Student.FirstName} {Model.Student.LastName}" : "N/A")</strong></p>
        </div>
        <div>
            <p class="field-label">Grade Level</p>
            <p><strong>@(Model.Student?.GradeLevel ?? "N/A")</strong></p>
        </div>
        <div>
            <p class="field-label">Sponsor ID</p>
            <p><strong>@Model.SponsorId</strong></p>
        </div>
        <div>
            <p class="field-label">Sponsor Name</p>
            <p><strong>@(Model.Sponsor?.SponsorName ?? "N/A")</strong></p>
        </div>
    </div>
</div>

<div class="card" style="padding: 0.75rem; margin-bottom: 0.75rem;">
    <h2 class="table-title" style="font-size: 1rem; margin-bottom: 0.5rem;">Coverage Dates</h2>
    <div class="data-grid" style="gap: 0.75rem;">
        <div>
            <p class="field-label">Effective From</p>
            <p><strong>@(Model.EffectiveFrom?.ToString("MMM dd, yyyy") ?? "Not Set")</strong></p>
        </div>
        <div>
            <p class="field-label">Effective To</p>
            <p><strong>@(Model.EffectiveTo?.ToString("MMM dd, yyyy") ?? "Not Set")</strong></p>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Notes) || !string.IsNullOrEmpty(Model.ReviewComments))
{
    <div class="card" style="padding: 0.75rem; margin-bottom: 0.75rem;">
        <h2 class="table-title" style="font-size: 1rem; margin-bottom: 0.5rem;">Notes and Comments</h2>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div style="margin-bottom: 0.5rem;">
                <p class="field-label" style="font-size: 0.875rem;">Notes</p>
                <p style="white-space: pre-wrap; font-size: 0.875rem;">@Model.Notes</p>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ReviewComments))
        {
            <div>
                <p class="field-label" style="font-size: 0.875rem;">Review Comments</p>
                <p style="white-space: pre-wrap; font-size: 0.875rem;">@Model.ReviewComments</p>
            </div>
        }
    </div>
}

<div class="card" style="padding: 0.75rem; margin-bottom: 0.75rem;">
    <h2 class="table-title" style="font-size: 1rem; margin-bottom: 0.5rem;">Attachment</h2>
    @if (!string.IsNullOrEmpty(Model.AttachmentFileName))
    {
        <div class="data-grid" style="gap: 0.75rem;">
            <div>
                <p class="field-label">File Name</p>
                <p><strong>@Model.AttachmentFileName</strong></p>
            </div>
            <div>
                <p class="field-label">Uploaded On</p>
                <p><strong>@Model.AttachmentUploadedOn?.ToString("MMM dd, yyyy")</strong></p>
            </div>
        </div>
        <div style="margin-top: 0.75rem;">
            <a href="@Url.Action("DownloadAttachment", "LetterOfGuarantee", new { id = Model.LogId })" 
               class="btn-primary" 
               style="display: inline-block; padding: 0.5rem 1rem; text-decoration: none;"
               download>
                📎 Download Attachment
            </a>
        </div>
    }
    else
    {
        <p class="help-text" style="color: var(--gray-500);">No attachment</p>
    }
</div>

<div class="card" style="padding: 0.75rem; margin-bottom: 0.75rem;">
    <h2 class="table-title" style="font-size: 1rem; margin-bottom: 0.5rem;">Audit Trail</h2>
    <div class="data-grid" style="gap: 0.75rem;">
        <div>
            <p class="field-label">Created On</p>
            <p><strong>@Model.CreatedOn.ToString("MMM dd, yyyy")</strong></p>
        </div>
        <div>
            <p class="field-label">Created By</p>
            <p><strong>@(Model.CreatedByUser?.DisplayName ?? "System")</strong></p>
        </div>
        @if (Model.ModifiedOn.HasValue)
        {
            <div>
                <p class="field-label">Modified On</p>
                <p><strong>@Model.ModifiedOn?.ToString("MMM dd, yyyy")</strong></p>
            </div>
            <div>
                <p class="field-label">Modified By</p>
                <p><strong>@(Model.ModifiedByUser?.DisplayName ?? "System")</strong></p>
            </div>
        }
    </div>
    
    @* Approval Workflow History *@
    @if (Model.SubmittedOn.HasValue || Model.ApprovedOn.HasValue || Model.RejectedOn.HasValue)
    {
        <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--gray-200);">
            <h3 style="margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 600;">Approval History</h3>
            <div class="data-grid" style="gap: 0.75rem;">
                @if (Model.SubmittedOn.HasValue)
                {
                    <div>
                        <p class="field-label">📤 Submitted On</p>
                        <p><strong>@Model.SubmittedOn?.ToString("MMM dd, yyyy")</strong></p>
                    </div>
                    <div>
                        <p class="field-label">Submitted By</p>
                        <p><strong>@(Model.SubmittedByUser?.DisplayName ?? "Unknown")</strong></p>
                    </div>
                }
                @if (Model.ApprovedOn.HasValue)
                {
                    <div>
                        <p class="field-label">✓ Approved On</p>
                        <p><strong style="color: var(--success-color);">@Model.ApprovedOn?.ToString("MMM dd, yyyy")</strong></p>
                    </div>
                    <div>
                        <p class="field-label">Approved By</p>
                        <p><strong style="color: var(--success-color);">@(Model.ApprovedByUser?.DisplayName ?? "Unknown")</strong></p>
                    </div>
                }
                @if (Model.RejectedOn.HasValue)
                {
                    <div>
                        <p class="field-label">✕ Rejected On</p>
                        <p><strong style="color: var(--error-color);">@Model.RejectedOn?.ToString("MMM dd, yyyy")</strong></p>
                    </div>
                    <div>
                        <p class="field-label">Rejected By</p>
                        <p><strong style="color: var(--error-color);">@(Model.RejectedByUser?.DisplayName ?? "Unknown")</strong></p>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Deactivation Modal -->
@if (User.IsInRole("admin") && Model.IsActive)
{
    <div id="deactivateModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
        <div class="card" style="max-width: 500px; margin: 2rem;">
            <h2>Deactivate Letter of Guarantee</h2>
            <form asp-action="Deactivate" asp-route-id="@Model.LogId" method="post">
                <div class="form-group">
                    <label for="reason" class="field-label">Reason for Deactivation <span class="required">*</span></label>
                    <textarea name="reason" id="reason" rows="4" placeholder="Explain why this LoG is being deactivated" required></textarea>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-danger"> Confirm Deactivation</button>
                    <button type="button" class="btn-secondary" onclick="document.getElementById('deactivateModal').style.display='none';">Cancel</button>
                </div>
            </form>
        </div>
    </div>
    
    <script>
        document.getElementById('deactivateModal').addEventListener('click', function(e) {
            if (e.target === this) {
                this.style.display = 'none';
            }
        });
    </script>
}

<!-- Rejection Modal -->
@if (User.IsInRole("admin") && Model.LogStatus == "Submitted")
{
    <div id="rejectionModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
        <div class="card" style="max-width: 500px; margin: 2rem;">
            <h2>Reject Letter of Guarantee</h2>
            <form asp-action="Reject" asp-route-id="@Model.LogId" method="post">
                <div class="form-group">
                    <label for="rejectionReason" class="field-label">Reason for Rejection <span class="required">*</span></label>
                    <textarea name="rejectionReason" id="rejectionReason" rows="4" placeholder="Explain why this LoG is being rejected (e.g., missing documentation, incorrect information, etc.)" required></textarea>
                    <p class="help-text" style="margin-top: 0.5rem;">The submitter will see this reason and can resubmit after making corrections.</p>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-danger">✕ Confirm Rejection</button>
                    <button type="button" class="btn-secondary" onclick="document.getElementById('rejectionModal').style.display='none';">Cancel</button>
                </div>
            </form>
        </div>
    </div>
    
    <script>
        document.getElementById('rejectionModal').addEventListener('click', function(e) {
            if (e.target === this) {
                this.style.display = 'none';
            }
        });
    </script>
}