@model ISMSponsor.Models.Domain.LogCoverage

<!-- Step Progress Bar -->
<div style="display: flex; margin-bottom: 24px; border-bottom: 2px solid #e5e7eb;">
    <div class="step-tab active" data-step="1" data-modal="details" onclick="goToDetailsStep(1)">
        <span class="step-number">1</span>
        <span class="step-label">Basic Info</span>
    </div>
    <div class="step-tab" data-step="2" data-modal="details" onclick="goToDetailsStep(2)">
        <span class="step-number">2</span>
        <span class="step-label">Coverage Details</span>
    </div>
    <div class="step-tab" data-step="3" data-modal="details" onclick="goToDetailsStep(3)">
        <span class="step-number">3</span>
        <span class="step-label">Notes & Status</span>
    </div>
    <div class="step-tab" data-step="4" data-modal="details" onclick="goToDetailsStep(4)">
        <span class="step-number">4</span>
        <span class="step-label">Attachment</span>
    </div>
</div>

<div>
    @Html.AntiForgeryToken()
    
    <!-- Step 1: Basic Info -->
    <div class="step-content active" data-step="1" data-modal="details">
        <h3 class="form-section-title">Student and Sponsor Information</h3>
        
        <div class="form-group">
            <label class="field-label">School Year</label>
            <input type="text" value="@Model.SchoolYearId" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;" />
        </div>
        
        <div class="form-group">
            <label class="field-label">Sponsor</label>
            <input type="text" value="@(Model.Sponsor?.SponsorName ?? Model.SponsorId)" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;" />
        </div>
        
        <div class="form-group">
            <label class="field-label">Student</label>
            <input type="text" value="@(Model.Student != null ? $"{Model.Student.FirstName} {Model.Student.LastName} ({Model.StudentId})" : Model.StudentId)" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;" />
            <p class="help-text">Student ID: @Model.StudentId | Grade: @(Model.Student?.GradeLevel ?? "N/A")</p>
        </div>
        
        <div class="form-group">
            <label class="field-label">Status</label>
            <input type="text" value="@Model.LogStatus" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;" />
        </div>
        
        @if (Model.IsActive)
        {
            <div class="alert alert-success">
                <strong>Active Coverage</strong> - This LoG is currently active
                @if (Model.ActivatedOn.HasValue)
                {
                    <text> (Activated on @Model.ActivatedOn?.ToString("MMM dd, yyyy"))</text>
                }
            </div>
        }
        else if (Model.LogStatus == "Submitted")
        {
            <div class="alert" style="background: #fef3c7; color: #92400e; border-left: 4px solid #f59e0b;">
                <strong>⏳ Awaiting Admin Review</strong> - This LoG is waiting for administrator approval.
            </div>
        }
    </div>
    
    <!-- Step 2: Coverage Details -->
    <div class="step-content" data-step="2" data-modal="details" style="display: none;">
        <h3 class="form-section-title">Coverage Period</h3>
        
        <div class="form-group">
            <label class="field-label">Effective From</label>
            <input type="text" value="@(Model.EffectiveFrom?.ToString("MMM dd, yyyy") ?? "Not Set")" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;" />
        </div>
        
        <div class="form-group">
            <label class="field-label">Effective To</label>
            <input type="text" value="@(Model.EffectiveTo?.ToString("MMM dd, yyyy") ?? "Not Set")" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;" />
        </div>
        
        <h3 class="form-section-title">Audit Information</h3>
        
        <div class="form-group">
            <label class="field-label">Created On</label>
            <input type="text" value="@Model.CreatedOn.ToString("MMM dd, yyyy")" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;" />
        </div>
        
        <div class="form-group">
            <label class="field-label">Created By</label>
            <input type="text" value="@(Model.CreatedByUser?.DisplayName ?? "System")" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;" />
        </div>
        
        @if (Model.SubmittedOn.HasValue)
        {
            <div class="form-group">
                <label class="field-label">Submitted On</label>
                <input type="text" value="@Model.SubmittedOn?.ToString("MMM dd, yyyy")" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;" />
            </div>
            
            <div class="form-group">
                <label class="field-label">Submitted By</label>
                <input type="text" value="@(Model.SubmittedByUser?.DisplayName ?? "Unknown")" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;" />
            </div>
        }
    </div>
    
    <!-- Step 3: Notes & Status -->
    <div class="step-content" data-step="3" data-modal="details" style="display: none;">
        <h3 class="form-section-title">Notes and Comments</h3>
        
        <div class="form-group">
            <label class="field-label">Notes</label>
            <textarea rows="4" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;">@Model.Notes</textarea>
        </div>
        
        <div class="form-group">
            <label class="field-label">Review Comments</label>
            <textarea rows="3" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;">@Model.ReviewComments</textarea>
        </div>
        
        @if (Model.ApprovedOn.HasValue || Model.RejectedOn.HasValue)
        {
            <h3 class="form-section-title">Approval Decision</h3>
            
            @if (Model.ApprovedOn.HasValue)
            {
                <div class="alert alert-success">
                    <strong>✓ Approved</strong> on @Model.ApprovedOn?.ToString("MMM dd, yyyy") by @(Model.ApprovedByUser?.DisplayName ?? "Unknown")
                </div>
            }
            
            @if (Model.RejectedOn.HasValue)
            {
                <div class="alert alert-error">
                    <strong>✕ Rejected</strong> on @Model.RejectedOn?.ToString("MMM dd, yyyy") by @(Model.RejectedByUser?.DisplayName ?? "Unknown")
                </div>
            }
        }
    </div>
    
    <!-- Step 4: Attachment -->
    <div class="step-content" data-step="4" data-modal="details" style="display: none;">
        <h3 class="form-section-title">Document Attachment</h3>
        
        @if (!string.IsNullOrEmpty(Model.AttachmentFileName))
        {
            <div class="form-group">
                <label class="field-label">File Name</label>
                <input type="text" value="@Model.AttachmentFileName" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;" />
            </div>
            
            <div class="form-group">
                <label class="field-label">Uploaded On</label>
                <input type="text" value="@Model.AttachmentUploadedOn?.ToString("MMM dd, yyyy")" readonly style="background-color: #f3f4f6; border: 1px solid #d1d5db;" />
            </div>
            
            <div class="form-group">
                <a href="@Url.Action("DownloadAttachment", "LetterOfGuarantee", new { id = Model.LogId })" 
                   class="btn-secondary"
                   download 
                   style="display: inline-block; text-decoration: none;">
                    📎 Download Attachment
                </a>
            </div>
        }
        else
        {
            <p class="help-text">No attachment uploaded</p>
        }
    </div>
    
    <!-- Navigation and Action Buttons -->
    @if (Model.LogStatus == "Submitted" && User.IsInRole("admin"))
    {
        <!-- Admin Approval Actions -->
        <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
            <button type="button" class="btn-secondary" id="detailsPrevStepBtn" onclick="previousDetailsStep()" style="display: none;">
                ← Previous
            </button>
            <button type="button" class="btn-primary" id="detailsNextStepBtn" onclick="nextDetailsStep()" style="flex: 1; display: none;">
                Next →
            </button>
            
            <!-- Approval Buttons (Replace Create LoG) -->
            <button type="button" class="btn-danger" onclick="rejectLogFromModal(@Model.LogId)" style="flex: 1;" id="detailsRejectBtn">
                ✕ Reject
            </button>
            <button type="button" class="btn-primary" onclick="approveLogFromModal(@Model.LogId)" style="flex: 1;" id="detailsApproveBtn">
                ✓ Approve & Activate
            </button>
            
            <button type="button" class="btn-secondary" onclick="closeDetailsModal()">
                Cancel
            </button>
        </div>
    }
    else
    {
        <!-- Regular Navigation -->
        <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
            <button type="button" class="btn-secondary" id="detailsPrevStepBtn" onclick="previousDetailsStep()" style="display: none;">
                ← Previous
            </button>
            <button type="button" class="btn-primary" id="detailsNextStepBtn" onclick="nextDetailsStep()" style="flex: 1;">
                Next →
            </button>
            <button type="button" class="btn-secondary" onclick="closeDetailsModal()">
                Close
            </button>
        </div>
    }
</div>

<script>
let currentDetailsStep = 1;
const totalDetailsSteps = 4;

function goToDetailsStep(step) {
    currentDetailsStep = step;
    
    // Hide all steps
    document.querySelectorAll('.step-content[data-modal="details"]').forEach(content => {
        content.style.display = 'none';
    });
    document.querySelectorAll('.step-tab[data-modal="details"]').forEach(tab => {
        tab.classList.remove('active');
    });
    
    // Show selected step
    const selectedContent = document.querySelector(`.step-content[data-modal="details"][data-step="${step}"]`);
    const selectedTab = document.querySelector(`.step-tab[data-modal="details"][data-step="${step}"]`);
    
    if (selectedContent) selectedContent.style.display = 'block';
    if (selectedTab) selectedTab.classList.add('active');
    
    // Update navigation buttons
    updateDetailsNavigationButtons();
}

function nextDetailsStep() {
    if (currentDetailsStep < totalDetailsSteps) {
        goToDetailsStep(currentDetailsStep + 1);
    }
}

function previousDetailsStep() {
    if (currentDetailsStep > 1) {
        goToDetailsStep(currentDetailsStep - 1);
    }
}

function updateDetailsNavigationButtons() {
    const prevBtn = document.getElementById('detailsPrevStepBtn');
    const nextBtn = document.getElementById('detailsNextStepBtn');
    const rejectBtn = document.getElementById('detailsRejectBtn');
    const approveBtn = document.getElementById('detailsApproveBtn');
    
    if (prevBtn) {
        prevBtn.style.display = currentDetailsStep === 1 ? 'none' : 'block';
    }
    
    // Show/hide navigation vs approval buttons
    if (currentDetailsStep === totalDetailsSteps) {
        if (nextBtn) nextBtn.style.display = 'none';
        if (rejectBtn) rejectBtn.style.display = 'flex';
        if (approveBtn) approveBtn.style.display = 'flex';
    } else {
        if (nextBtn) {
            nextBtn.style.display = 'flex';
            nextBtn.style.flex = '1';
        }
        if (rejectBtn) rejectBtn.style.display = 'none';
        if (approveBtn) approveBtn.style.display = 'none';
    }
}

async function approveLogFromModal(logId) {
    if (!confirm('Approve this Letter of Guarantee? It will be automatically activated.')) {
        return;
    }
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    
    try {
        const formData = new FormData();
        formData.append('reviewComments', '');
        
        const response = await fetch(`/Settings/LetterOfGuarantee/Approve/${logId}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        });
        
        if (response.ok) {
            alert('Letter of Guarantee approved successfully!');
            closeDetailsModal();
            window.location.reload();
        } else {
            alert('Failed to approve. Please try again.');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('An error occurred. Please try again.');
    }
}

async function rejectLogFromModal(logId) {
    const reason = prompt('Please enter the reason for rejection:');
    if (!reason || reason.trim() === '') {
        alert('Rejection reason is required.');
        return;
    }
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    
    try {
        const formData = new FormData();
        formData.append('rejectionReason', reason);
        
        const response = await fetch(`/Settings/LetterOfGuarantee/Reject/${logId}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        });
        
        if (response.ok) {
            alert('Letter of Guarantee rejected successfully!');
            closeDetailsModal();
            window.location.reload();
        } else {
            alert('Failed to reject. Please try again.');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('An error occurred. Please try again.');
    }
}

// Initialize navigation buttons on load
if (document.getElementById('detailsPrevStepBtn')) {
    updateDetailsNavigationButtons();
}
</script>



