@model ISMSponsor.Models.Domain.LogCoverage

<style>
    .readonly-field {
        background-color: #f9fafb;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 0.75rem;
        font-size: 0.875rem;
        color: #111827;
        min-height: 42px;
        display: flex;
        align-items: center;
    }
    .readonly-field strong {
        color: #111827;
        font-weight: 500;
    }
</style>

<!-- Step Progress Bar -->
<div style="display: flex; margin-bottom: 24px; border-bottom: 2px solid #e5e7eb;">
    <div class="step-tab active" data-step="1" data-modal="details" onclick="goToDetailsStep(1)">
        <span class="step-number">1</span>
        <span class="step-label">Basic Info</span>
    </div>
    <div class="step-tab" data-step="2" data-modal="details" onclick="goToDetailsStep(2)">
        <span class="step-number">2</span>
        <span class="step-label">Coverage & Dates</span>
    </div>
    <div class="step-tab" data-step="3" data-modal="details" onclick="goToDetailsStep(3)">
        <span class="step-number">3</span>
        <span class="step-label">Attachment</span>
    </div>
    <div class="step-tab" data-step="4" data-modal="details" onclick="goToDetailsStep(4)">
        <span class="step-number">4</span>
        <span class="step-label">Audit & Approval</span>
    </div>
</div>

<div id="detailsModalContent">
    <!-- Step 1: Basic Info -->
    <div class="step-content active" data-step="1" data-modal="details">
        <h3 class="form-section-title">Status and Activation</h3>
        
        <div class="form-group">
            <label class="field-label">Current Status</label>
            <div class="readonly-field">
                <span class="status-badge status-@Model.LogStatus.ToLower()">@Model.LogStatus</span>
            </div>
        </div>
        
        <div class="form-group">
            <label class="field-label">Activation State</label>
            <div class="readonly-field">
                @if (Model.IsActive)
                {
                    <span class="status-badge status-active">Active</span>
                }
                else
                {
                    <span class="status-badge status-inactive">Inactive</span>
                }
            </div>
        </div>

        @if (Model.IsActive && Model.ActivatedOn.HasValue)
        {
            <div class="alert alert-success" style="margin-bottom: 16px;">
                <strong>Active Coverage</strong> - Activated @Model.ActivatedOn?.ToString("MMM dd, yyyy")
                @if (Model.ActivatedByUser != null)
                {
                    <text> by @Model.ActivatedByUser.DisplayName</text>
                }
            </div>
        }
        else if (Model.DeactivatedOn.HasValue)
        {
            <div class="alert alert-error" style="margin-bottom: 16px;">
                <strong>Deactivated</strong> - @Model.DeactivatedOn?.ToString("MMM dd, yyyy")
                @if (Model.DeactivatedByUser != null)
                {
                    <text> by @Model.DeactivatedByUser.DisplayName</text>
                }
                @if (!string.IsNullOrEmpty(Model.DeactivationReason))
                {
                    <text> | Reason: @Model.DeactivationReason</text>
                }
            </div>
        }
        else if (@Model.LogStatus == "Approved")
        {
            <div class="alert alert-success" style="margin-bottom: 16px;">
                <strong>✓ Approved & Active</strong> - This LoG has been approved and is currently active.
            </div>
        }
        else if (@Model.LogStatus == "Rejected")
        {
            <div class="alert alert-error" style="margin-bottom: 16px;">
                <strong>✕ Rejected</strong> - This LoG has been rejected. Review comments below.
            </div>
        }
        else if (@Model.LogStatus == "Submitted")
        {
            <div class="alert" style="margin-bottom: 16px; background: #fef3c7; color: #92400e; border-left: 4px solid #f59e0b;">
                <strong>⏳ Awaiting Admin Review</strong> - This LoG is waiting for administrator approval.
            </div>
        }

        <h3 class="form-section-title">Student and Sponsor Information</h3>
        
        <div class="form-group">
            <label class="field-label">School Year</label>
            <div class="readonly-field"><strong>@Model.SchoolYearId</strong></div>
        </div>
        
        <div class="form-group">
            <label class="field-label">Student ID</label>
            <div class="readonly-field"><strong>@Model.StudentId</strong></div>
        </div>
        
        <div class="form-group">
            <label class="field-label">Student Name</label>
            <div class="readonly-field"><strong>@(Model.Student != null ? $"{Model.Student.FirstName} {Model.Student.LastName}" : "N/A")</strong></div>
        </div>
        
        <div class="form-group">
            <label class="field-label">Grade Level</label>
            <div class="readonly-field"><strong>@(Model.Student?.GradeLevel ?? "N/A")</strong></div>
        </div>
        
        <div class="form-group">
            <label class="field-label">Sponsor ID</label>
            <div class="readonly-field"><strong>@Model.SponsorId</strong></div>
        </div>
        
        <div class="form-group">
            <label class="field-label">Sponsor Name</label>
            <div class="readonly-field"><strong>@(Model.Sponsor?.SponsorName ?? "N/A")</strong></div>
        </div>
    </div>

    <!-- Step 2: Coverage & Dates -->
    <div class="step-content" data-step="2" data-modal="details" style="display: none;">
        <h3 class="form-section-title">Coverage Period</h3>
        
        <div class="form-group">
            <label class="field-label">Effective From</label>
            <div class="readonly-field"><strong>@(Model.EffectiveFrom?.ToString("MMM dd, yyyy") ?? "Not Set")</strong></div>
        </div>
        
        <div class="form-group">
            <label class="field-label">Effective To</label>
            <div class="readonly-field"><strong>@(Model.EffectiveTo?.ToString("MMM dd, yyyy") ?? "Not Set")</strong></div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes) || !string.IsNullOrEmpty(Model.ReviewComments))
        {
            <h3 class="form-section-title">Notes and Comments</h3>
            
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="form-group">
                    <label class="field-label">Notes</label>
                    <div class="readonly-field" style="display: block; white-space: pre-wrap; min-height: auto; padding: 0.75rem;">@Model.Notes</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ReviewComments))
            {
                <div class="form-group">
                    <label class="field-label">Review Comments</label>
                    <div class="readonly-field" style="display: block; white-space: pre-wrap; min-height: auto; padding: 0.75rem;">@Model.ReviewComments</div>
                </div>
            }
        }
    </div>

    <!-- Step 3: Attachment -->
    <div class="step-content" data-step="3" data-modal="details" style="display: none;">
        <h3 class="form-section-title">Document Attachment</h3>
        
        @if (!string.IsNullOrEmpty(Model.AttachmentFileName))
        {
            <div class="form-group">
                <label class="field-label">File Name</label>
                <div class="readonly-field"><strong>@Model.AttachmentFileName</strong></div>
            </div>
            
            <div class="form-group">
                <label class="field-label">Uploaded On</label>
                <div class="readonly-field"><strong>@Model.AttachmentUploadedOn?.ToString("MMM dd, yyyy")</strong></div>
            </div>
            
            <div class="form-group">
                <a href="@Url.Action("DownloadAttachment", "LetterOfGuarantee", new { id = Model.LogId })" 
                   class="btn-primary btn-add"
                   download>
                    📎 Download Attachment
                </a>
                <p class="help-text">Click to download and review the attached document</p>
            </div>
        }
        else
        {
            <p class="help-text">No attachment uploaded</p>
        }
    </div>

    <!-- Step 4: Audit & Approval -->
    <div class="step-content" data-step="4" data-modal="details" style="display: none;">
        <h3 class="form-section-title">Audit Trail</h3>
        
        <div class="form-group">
            <label class="field-label">Created On</label>
            <div class="readonly-field"><strong>@Model.CreatedOn.ToString("MMM dd, yyyy")</strong></div>
        </div>
        
        <div class="form-group">
            <label class="field-label">Created By</label>
            <div class="readonly-field"><strong>@(Model.CreatedByUser?.DisplayName ?? "System")</strong></div>
        </div>
        
        @if (Model.ModifiedOn.HasValue)
        {
            <div class="form-group">
                <label class="field-label">Modified On</label>
                <div class="readonly-field"><strong>@Model.ModifiedOn?.ToString("MMM dd, yyyy")</strong></div>
            </div>
            
            <div class="form-group">
                <label class="field-label">Modified By</label>
                <div class="readonly-field"><strong>@(Model.ModifiedByUser?.DisplayName ?? "System")</strong></div>
            </div>
        }
        
        @if (Model.SubmittedOn.HasValue || Model.ApprovedOn.HasValue || Model.RejectedOn.HasValue)
        {
            <h3 class="form-section-title">Approval History</h3>
            
            @if (Model.SubmittedOn.HasValue)
            {
                <div class="form-group">
                    <label class="field-label">📤 Submitted On</label>
                    <div class="readonly-field"><strong>@Model.SubmittedOn?.ToString("MMM dd, yyyy")</strong></div>
                </div>
                
                <div class="form-group">
                    <label class="field-label">Submitted By</label>
                    <div class="readonly-field"><strong>@(Model.SubmittedByUser?.DisplayName ?? "Unknown")</strong></div>
                </div>
            }
            @if (Model.ApprovedOn.HasValue)
            {
                <div class="form-group">
                    <label class="field-label">✓ Approved On</label>
                    <div class="readonly-field" style="border-color: var(--success-color); background-color: #f0fdf4;">
                        <strong style="color: var(--success-color);">@Model.ApprovedOn?.ToString("MMM dd, yyyy")</strong>
                    </div>
                </div>
                
                <div class="form-group">
                    <label class="field-label">Approved By</label>
                    <div class="readonly-field" style="border-color: var(--success-color); background-color: #f0fdf4;">
                        <strong style="color: var(--success-color);">@(Model.ApprovedByUser?.DisplayName ?? "Unknown")</strong>
                    </div>
                </div>
            }
            @if (Model.RejectedOn.HasValue)
            {
                <div class="form-group">
                    <label class="field-label">✕ Rejected On</label>
                    <div class="readonly-field" style="border-color: var(--error-color); background-color: #fef2f2;">
                        <strong style="color: var(--error-color);">@Model.RejectedOn?.ToString("MMM dd, yyyy")</strong>
                    </div>
                </div>
                
                <div class="form-group">
                    <label class="field-label">Rejected By</label>
                    <div class="readonly-field" style="border-color: var(--error-color); background-color: #fef2f2;">
                        <strong style="color: var(--error-color);">@(Model.RejectedByUser?.DisplayName ?? "Unknown")</strong>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (Model.LogStatus == "Submitted" && User.IsInRole("admin"))
{
    <!-- Approval Actions (matching Create modal's button layout) -->
    <div style="border-top: 1px solid #e5e7eb; padding-top: 24px; margin-top: 24px;">
        <div class="form-group">
            <label for="modalApprovalComments" class="field-label">Approval Comments (Optional)</label>
            <textarea id="modalApprovalComments" name="reviewComments" rows="3" placeholder="Add any notes about this approval or rejection..."></textarea>
        </div>
        
        <div style="display: flex; gap: 12px; margin-top: 24px;">
            <button type="button" class="btn-secondary" onclick="closeDetailsModal()">
                Cancel
            </button>
            <button type="button" class="btn-danger" onclick="rejectLogFromModal(@Model.LogId)" style="flex: 1;">
                ✕ Reject
            </button>
            <button type="button" class="btn-primary" onclick="approveLogFromModal(@Model.LogId)" style="flex: 1;">
                ✓ Approve & Activate
            </button>
        </div>
    </div>
}
else
{
    <!-- Navigation Buttons (matching Create modal) -->
    <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
        <button type="button" class="btn-secondary" id="detailsPrevStepBtn" onclick="previousDetailsStep()" style="display: none;">
            ← Previous
        </button>
        <button type="button" class="btn-primary" id="detailsNextStepBtn" onclick="nextDetailsStep()" style="flex: 1;">
            Next →
        </button>
        <button type="button" class="btn-secondary" onclick="closeDetailsModal()">
            Close
        </button>
    </div>
}

<script>
let currentDetailsStep = 1;
const totalDetailsSteps = 4;

function goToDetailsStep(step) {
    currentDetailsStep = step;
    
    // Hide all steps
    document.querySelectorAll('.step-content[data-modal="details"]').forEach(content => {
        content.style.display = 'none';
    });
    document.querySelectorAll('.step-tab[data-modal="details"]').forEach(tab => {
        tab.classList.remove('active');
    });
    
    // Show selected step
    const selectedContent = document.querySelector(`.step-content[data-modal="details"][data-step="${step}"]`);
    const selectedTab = document.querySelector(`.step-tab[data-modal="details"][data-step="${step}"]`);
    
    if (selectedContent) selectedContent.style.display = 'block';
    if (selectedTab) selectedTab.classList.add('active');
    
    // Update navigation buttons
    updateDetailsNavigationButtons();
}

function nextDetailsStep() {
    if (currentDetailsStep < totalDetailsSteps) {
        goToDetailsStep(currentDetailsStep + 1);
    }
}

function previousDetailsStep() {
    if (currentDetailsStep > 1) {
        goToDetailsStep(currentDetailsStep - 1);
    }
}

function updateDetailsNavigationButtons() {
    const prevBtn = document.getElementById('detailsPrevStepBtn');
    const nextBtn = document.getElementById('detailsNextStepBtn');
    
    if (prevBtn) {
        prevBtn.style.display = currentDetailsStep === 1 ? 'none' : 'block';
    }
    
    if (nextBtn) {
        if (currentDetailsStep === totalDetailsSteps) {
            nextBtn.style.display = 'none';
        } else {
            nextBtn.style.display = 'flex';
            nextBtn.style.flex = '1';
        }
    }
}

async function approveLogFromModal(logId) {
    if (!confirm('Approve this Letter of Guarantee? It will be automatically activated.')) {
        return;
    }
    
    const comments = document.getElementById('modalApprovalComments').value;
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    
    try {
        const formData = new FormData();
        formData.append('reviewComments', comments);
        
        const response = await fetch(`/Settings/LetterOfGuarantee/Approve/${logId}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        });
        
        if (response.ok) {
            alert('Letter of Guarantee approved successfully!');
            closeDetailsModal();
            window.location.reload();
        } else {
            alert('Failed to approve. Please try again.');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('An error occurred. Please try again.');
    }
}

async function rejectLogFromModal(logId) {
    const reason = prompt('Please enter the reason for rejection:');
    if (!reason || reason.trim() === '') {
        alert('Rejection reason is required.');
        return;
    }
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    
    try {
        const formData = new FormData();
        formData.append('rejectionReason', reason);
        
        const response = await fetch(`/Settings/LetterOfGuarantee/Reject/${logId}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        });
        
        if (response.ok) {
            alert('Letter of Guarantee rejected successfully!');
            closeDetailsModal();
            window.location.reload();
        } else {
            alert('Failed to reject. Please try again.');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('An error occurred. Please try again.');
    }
}

// Initialize navigation buttons on load
if (document.getElementById('detailsPrevStepBtn')) {
    updateDetailsNavigationButtons();
}
</script>


