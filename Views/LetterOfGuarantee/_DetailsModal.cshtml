@model ISMSponsor.Models.Domain.LogCoverage

<!-- Step Progress Bar -->
<div style="display: flex; margin-bottom: 24px; border-bottom: 2px solid #e5e7eb;">
    <div class="step-tab active" data-step="1" data-modal="details" onclick="goToDetailsStep(1)">
        <span class="step-number">1</span>
        <span class="step-label">Basic Info</span>
    </div>
    <div class="step-tab" data-step="2" data-modal="details" onclick="goToDetailsStep(2)">
        <span class="step-number">2</span>
        <span class="step-label">Coverage Details</span>
    </div>
    <div class="step-tab" data-step="3" data-modal="details" onclick="goToDetailsStep(3)">
        <span class="step-number">3</span>
        <span class="step-label">Coverage Rules</span>
    </div>
    <div class="step-tab" data-step="4" data-modal="details" onclick="goToDetailsStep(4)">
        <span class="step-number">4</span>
        <span class="step-label">Attachment</span>
    </div>
</div>

<form>
    @Html.AntiForgeryToken()
    
    <!-- Step 1: Basic Info -->
    <div class="step-content active" data-step="1" data-modal="details">
        <h3 class="form-section-title">Student and Sponsor Information</h3>
        
        <div class="data-grid" style="margin-bottom: 1.5rem;">
            <div>
                <p class="field-label">School Year</p>
                <p><strong>@Model.SchoolYearId</strong></p>
            </div>
            <div>
                <p class="field-label">Student ID</p>
                <p><strong>@Model.StudentId</strong></p>
            </div>
            <div>
                <p class="field-label">Student Name</p>
                <p><strong>@(Model.Student != null ? $"{Model.Student.FirstName} {Model.Student.LastName}" : "N/A")</strong></p>
            </div>
        </div>
        
        <div class="form-group">
            <label for="detailsSponsorId" class="field-label">Sponsor</label>
            <select id="detailsSponsorId" disabled style="cursor: not-allowed;">
                <option selected>@(Model.Sponsor?.SponsorName ?? Model.SponsorId)</option>
            </select>
            <span class="form-error" id="detailsSponsorId-error"></span>
        </div>
        
        <div class="form-group">
            <label for="detailsLogStatus" class="field-label">Status</label>
            <select id="detailsLogStatus" disabled style="cursor: not-allowed;">
                <option selected>@Model.LogStatus</option>
            </select>
            <span class="form-error" id="detailsLogStatus-error"></span>
        </div>
        
        @if (Model.IsActive)
        {
            <div style="padding: 12px; border-radius: 6px; background: #d1fae5; color: #065f46; margin-top: 16px;">
                <strong>✓ Active Coverage</strong>
                @if (Model.ActivatedOn.HasValue)
                {
                    <text> - Activated on @Model.ActivatedOn?.ToString("MMM dd, yyyy")</text>
                }
                @if (Model.ActivatedByUser != null)
                {
                    <text> by @Model.ActivatedByUser.DisplayName</text>
                }
            </div>
        }
        else if (Model.DeactivatedOn.HasValue)
        {
            <div style="padding: 12px; border-radius: 6px; background: #fee2e2; color: #991b1b; margin-top: 16px;">
                <strong>✕ Deactivated</strong> - @Model.DeactivatedOn?.ToString("MMM dd, yyyy")
                @if (Model.DeactivatedByUser != null)
                {
                    <text> by @Model.DeactivatedByUser.DisplayName</text>
                }
                @if (!string.IsNullOrEmpty(Model.DeactivationReason))
                {
                    <br /><strong>Reason:</strong> @Model.DeactivationReason
                }
            </div>
        }
    </div>
    
    <!-- Step 2: Coverage Details -->
    <div class="step-content" data-step="2" data-modal="details" style="display: none;">
        <h3 class="form-section-title">Coverage Period and Notes</h3>
        
        <div class="form-group">
            <label for="detailsEffectiveFrom" class="field-label">Effective From</label>
            <input type="date" id="detailsEffectiveFrom" value="@(Model.EffectiveFrom?.ToString("yyyy-MM-dd"))" readonly style="cursor: not-allowed;" />
            <span class="form-error" id="detailsEffectiveFrom-error"></span>
        </div>
        
        <div class="form-group">
            <label for="detailsEffectiveTo" class="field-label">Effective To</label>
            <input type="date" id="detailsEffectiveTo" value="@(Model.EffectiveTo?.ToString("yyyy-MM-dd"))" readonly style="cursor: not-allowed;" />
            <span class="form-error" id="detailsEffectiveTo-error"></span>
        </div>
        
        <div class="form-group">
            <label for="detailsNotes" class="field-label">Notes</label>
            <textarea id="detailsNotes" rows="4" readonly style="cursor: not-allowed;">@Model.Notes</textarea>
            <span class="form-error" id="detailsNotes-error"></span>
        </div>
        
        <div class="form-group">
            <label for="detailsReviewComments" class="field-label">Review Comments</label>
            <textarea id="detailsReviewComments" rows="3" readonly style="cursor: not-allowed;">@Model.ReviewComments</textarea>
            <span class="form-error" id="detailsReviewComments-error"></span>
        </div>
    </div>
    
    <!-- Step 3: Coverage Rules -->
    <div class="step-content" data-step="3" data-modal="details" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h3 class="form-section-title" style="margin: 0;">Coverage Rules</h3>
        </div>
        
        <p class="help-text" style="margin-bottom: 16px;">Define what items are covered and how much coverage applies</p>
        
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th style="width: 250px;">Item</th>
                        <th style="width: 120px;">Coverage Type</th>
                        <th style="width: 100px;">Value</th>
                        <th style="width: 120px;">Effective From</th>
                        <th style="width: 120px;">Effective To</th>
                        <th style="width: 60px;">Order</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.CoverageRules != null && Model.CoverageRules.Any())
                    {
                        foreach (var rule in Model.CoverageRules.OrderBy(r => r.DisplayOrder))
                        {
                            <tr>
                                <td style="font-weight: 500;">@(rule.Item?.ItemName ?? rule.ItemId)</td>
                                <td>
                                    <span class="status-badge" style="background: #e0e7ff; color: #3730a3; font-size: 0.75rem;">
                                        @rule.CoverageType
                                    </span>
                                </td>
                                <td style="font-family: monospace; font-weight: 500;">
                                    @if (rule.CoverageType == "Percentage" && rule.CoveragePercentage.HasValue)
                                    {
                                        <text>@rule.CoveragePercentage%</text>
                                    }
                                    else if (rule.CoverageType == "FixedAmount" && rule.CoverageFixedAmount.HasValue)
                                    {
                                        <text>$@rule.CoverageFixedAmount.Value.ToString("N2")</text>
                                    }
                                    else if (rule.CoverageType == "UpToCap" && rule.CapAmount.HasValue)
                                    {
                                        <text>Up to $@rule.CapAmount.Value.ToString("N2")</text>
                                    }
                                    else
                                    {
                                        <text>@rule.CoverageType</text>
                                    }
                                </td>
                                <td style="color: var(--gray-600); font-size: 0.875rem;">
                                    @(rule.EffectiveFrom?.ToString("MMM dd, yyyy") ?? "-")
                                </td>
                                <td style="color: var(--gray-600); font-size: 0.875rem;">
                                    @(rule.EffectiveTo?.ToString("MMM dd, yyyy") ?? "-")
                                </td>
                                <td style="text-align: center; font-weight: 500;">@rule.DisplayOrder</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 2rem; color: var(--gray-500);">
                                No coverage rules defined for this Letter of Guarantee.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Step 4: Attachment -->
    <div class="step-content" data-step="4" data-modal="details" style="display: none;">
        <h3 class="form-section-title">Document Attachment</h3>
        
        @if (!string.IsNullOrEmpty(Model.AttachmentFileName))
        {
            <div style="display: block; padding: 12px; background: #10b981; color: white; border-radius: 6px; margin-bottom: 16px;">
                <strong>Current Attachment:</strong> <span>@Model.AttachmentFileName</span>
                @if (Model.AttachmentUploadedOn.HasValue)
                {
                    <text> (Uploaded: @Model.AttachmentUploadedOn?.ToString("MMM dd, yyyy"))</text>
                }
                <a href="@Url.Action("DownloadAttachment", "LetterOfGuarantee", new { id = Model.LogId })" 
                   download
                   style="background: white; color: #10b981; padding: 0.4rem 0.8rem; border-radius: 4px; text-decoration: none; margin-left: 12px; display: inline-block; font-size: 0.875rem;">
                    📎 Download
                </a>
            </div>
        }
        
        <div class="form-group">
            <label for="detailsNewAttachment" class="field-label">Replace Attachment (Optional)</label>
            <input type="file" id="detailsNewAttachment" name="NewAttachment" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" disabled style="cursor: not-allowed;" />
            <span class="form-error" id="detailsNewAttachment-error"></span>
            <p class="help-text">Attachment replacement is not available in view mode</p>
        </div>
    </div>
    
    <!-- Navigation Buttons -->
    <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
        <button type="button" class="btn-secondary" id="detailsPrevStepBtn" onclick="previousDetailsStep()" style="display: none;">
            ← Previous
        </button>
        <button type="button" class="btn-primary" id="detailsNextStepBtn" onclick="nextDetailsStep()" style="flex: 1;">
            Next →
        </button>
        @if (Model.LogStatus == "Submitted" && User.IsInRole("admin"))
        {
            <button type="button" class="btn-danger" id="detailsRejectBtn" onclick="rejectLogFromModal(@Model.LogId)" style="display: none; flex: 1;">
                ✕ Reject
            </button>
            <button type="button" class="btn-primary" id="detailsApproveBtn" onclick="approveLogFromModal(@Model.LogId)" style="display: none; flex: 1;">
                ✓ Approve & Activate
            </button>
        }
        <button type="button" class="btn-secondary" onclick="closeDetailsModal()">
            <span id="closeButtonTextDetails">
                @if (Model.LogStatus == "Submitted" && User.IsInRole("admin"))
                {
                    <text>Cancel</text>
                }
                else
                {
                    <text>Close</text>
                }
            </span>
        </button>
    </div>
</form>



