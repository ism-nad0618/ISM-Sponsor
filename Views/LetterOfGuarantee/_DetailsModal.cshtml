@model ISMSponsor.Models.Domain.LogCoverage

<!-- Step Progress Bar -->
<div style="display: flex; margin-bottom: 24px; border-bottom: 2px solid #e5e7eb;">
    <div class="step-tab active" data-step="1" data-modal="details" onclick="goToDetailsStep(1)">
        <span class="step-number">1</span>
        <span class="step-label">Basic Info</span>
    </div>
    <div class="step-tab" data-step="2" data-modal="details" onclick="goToDetailsStep(2)">
        <span class="step-number">2</span>
        <span class="step-label">Coverage Details</span>
    </div>
    <div class="step-tab" data-step="3" data-modal="details" onclick="goToDetailsStep(3)">
        <span class="step-number">3</span>
        <span class="step-label">Coverage Rules</span>
    </div>
    <div class="step-tab" data-step="4" data-modal="details" onclick="goToDetailsStep(4)">
        <span class="step-number">4</span>
        <span class="step-label">Attachment</span>
    </div>
</div>

<form>
    @Html.AntiForgeryToken()
    
    <!-- Step 1: Basic Info -->
    <div class="step-content active" data-step="1" data-modal="details">
        <h3 class="form-section-title">Student and Sponsor Information</h3>
        
        <div class="form-group">
            <label class="field-label">School Year</label>
            <input type="text" value="@Model.SchoolYearId" readonly style="background-color: #f3f4f6; cursor: not-allowed;" />
        </div>
        
        <div class="form-group">
            <label class="field-label">Sponsor</label>
            <input type="text" value="@(Model.Sponsor?.SponsorName ?? Model.SponsorId)" readonly style="background-color: #f3f4f6; cursor: not-allowed;" />
        </div>
        
        <div class="form-group">
            <label class="field-label">Student</label>
            <input type="text" value="@(Model.Student != null ? $"{Model.Student.FirstName} {Model.Student.LastName}" : Model.StudentId)" readonly style="background-color: #f3f4f6; cursor: not-allowed;" />
            <span class="form-error"></span>
            <p class="help-text">Student ID: @Model.StudentId@(Model.Student != null ? $" | Grade: {Model.Student.GradeLevel}" : "")</p>
        </div>
        
        <div class="form-group">
            <label class="field-label">Status</label>
            <select disabled style="background-color: #f3f4f6; cursor: not-allowed;">
                <option selected>@Model.LogStatus</option>
            </select>
        </div>
    </div>
    
    <!-- Step 2: Coverage Details -->
    <div class="step-content" data-step="2" data-modal="details" style="display: none;">
        <h3 class="form-section-title">Coverage Period and Notes</h3>
        
        <div class="form-group">
            <label class="field-label">Effective From</label>
            <input type="date" value="@(Model.EffectiveFrom?.ToString("yyyy-MM-dd"))" readonly style="background-color: #f3f4f6; cursor: not-allowed;" />
            <span class="form-error"></span>
        </div>
        
        <div class="form-group">
            <label class="field-label">Effective To</label>
            <input type="date" value="@(Model.EffectiveTo?.ToString("yyyy-MM-dd"))" readonly style="background-color: #f3f4f6; cursor: not-allowed;" />
            <span class="form-error"></span>
        </div>
        
        <div class="form-group">
            <label class="field-label">Notes</label>
            <textarea rows="4" readonly style="background-color: #f3f4f6; cursor: not-allowed;">@Model.Notes</textarea>
            <span class="form-error"></span>
        </div>
        
        <div class="form-group">
            <label class="field-label">Review Comments</label>
            <textarea rows="3" readonly style="background-color: #f3f4f6; cursor: not-allowed;">@Model.ReviewComments</textarea>
            <span class="form-error"></span>
        </div>
    </div>
    
    <!-- Step 3: Coverage Rules -->
    <div class="step-content" data-step="3" data-modal="details" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h3 class="form-section-title" style="margin: 0;">Coverage Rules</h3>
        </div>
        
        <p class="help-text" style="margin-bottom: 16px;">Coverage rules defined for this Letter of Guarantee</p>
        
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th style="width: 250px;">Item</th>
                        <th style="width: 120px;">Coverage Type</th>
                        <th style="width: 100px;">Value</th>
                        <th style="width: 120px;">Effective From</th>
                        <th style="width: 120px;">Effective To</th>
                        <th style="width: 60px;">Order</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.CoverageRules != null && Model.CoverageRules.Any())
                    {
                        foreach (var rule in Model.CoverageRules.OrderBy(r => r.DisplayOrder))
                        {
                            <tr>
                                <td style="font-weight: 500;">@(rule.Item?.ItemName ?? rule.ItemId)</td>
                                <td>
                                    <span class="status-badge" style="background: #e0e7ff; color: #3730a3; font-size: 0.75rem;">
                                        @rule.CoverageType
                                    </span>
                                </td>
                                <td style="font-family: monospace; font-weight: 500;">
                                    @if (rule.CoverageType == "Percentage" && rule.CoveragePercentage.HasValue)
                                    {
                                        <text>@rule.CoveragePercentage%</text>
                                    }
                                    else if (rule.CoverageType == "FixedAmount" && rule.CoverageFixedAmount.HasValue)
                                    {
                                        <text>$@rule.CoverageFixedAmount.Value.ToString("N2")</text>
                                    }
                                    else if (rule.CoverageType == "UpToCap" && rule.CapAmount.HasValue)
                                    {
                                        <text>Up to $@rule.CapAmount.Value.ToString("N2")</text>
                                    }
                                    else
                                    {
                                        <text>@rule.CoverageType</text>
                                    }
                                </td>
                                <td style="color: var(--gray-600); font-size: 0.875rem;">
                                    @(rule.EffectiveFrom?.ToString("MMM dd, yyyy") ?? "-")
                                </td>
                                <td style="color: var(--gray-600); font-size: 0.875rem;">
                                    @(rule.EffectiveTo?.ToString("MMM dd, yyyy") ?? "-")
                                </td>
                                <td style="text-align: center; font-weight: 500;">@rule.DisplayOrder</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 2rem; color: var(--gray-500);">
                                No coverage rules defined for this Letter of Guarantee.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Step 4: Attachment -->
    <div class="step-content" data-step="4" data-modal="details" style="display: none;">
        <h3 class="form-section-title">Document Attachment</h3>
        
        @if (!string.IsNullOrEmpty(Model.AttachmentFileName))
        {
            <div class="form-group">
                <label class="field-label">Current Attachment</label>
                <div style="display: flex; gap: 12px; align-items: center;">
                    <input type="text" value="@Model.AttachmentFileName" readonly style="background-color: #f3f4f6; flex: 1; cursor: not-allowed;" />
                    <a href="@Url.Action("DownloadAttachment", "LetterOfGuarantee", new { id = Model.LogId })" 
                       class="btn-secondary" 
                       download
                       style="white-space: nowrap;">
                        📎 Download
                    </a>
                </div>
                <span class="form-error"></span>
                <p class="help-text">Uploaded on @Model.AttachmentUploadedOn?.ToString("MMM dd, yyyy")</p>
            </div>
        }
        else
        {
            <div class="form-group">
                <label class="field-label">Upload Attachment (Optional)</label>
                <input type="file" disabled style="background-color: #f3f4f6; cursor: not-allowed;" />
                <span class="form-error"></span>
                <p class="help-text">No attachment uploaded for this Letter of Guarantee</p>
            </div>
        }
    </div>
    
    <!-- Navigation Buttons -->
    <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
        <button type="button" class="btn-secondary" id="detailsPrevStepBtn" onclick="previousDetailsStep()" style="display: none;">
            ← Previous
        </button>
        <button type="button" class="btn-primary" id="detailsNextStepBtn" onclick="nextDetailsStep()" style="flex: 1;">
            Next →
        </button>
        @if (Model.LogStatus == "Submitted" && User.IsInRole("admin"))
        {
            <button type="button" class="btn-danger" id="detailsRejectBtn" onclick="rejectLogFromModal(@Model.LogId)" style="display: none; flex: 1;">
                ✕ Reject
            </button>
            <button type="button" class="btn-primary" id="detailsApproveBtn" onclick="approveLogFromModal(@Model.LogId)" style="display: none; flex: 1;">
                ✓ Approve & Activate
            </button>
        }
        <button type="button" class="btn-secondary" onclick="closeDetailsModal()">
            @if (Model.LogStatus == "Submitted" && User.IsInRole("admin"))
            {
                <text>Cancel</text>
            }
            else
            {
                <text>Close</text>
            }
        </button>
    </div>
</form>



