@model ISMSponsor.Models.Domain.LogCoverage

<div class="modal-body" style="padding: 1rem;">
    <!-- Basic Info -->
    <div>
        <h3 class="form-section-title" style="margin-bottom: 0.5rem; font-size: 1rem;">Student and Sponsor Information</h3>
        
        <div class="data-grid" style="margin-bottom: 0.75rem; gap: 0.5rem;">
            <div>
                <p class="field-label" style="margin-bottom: 0.25rem; font-size: 0.85rem;">School Year</p>
                <p style="margin: 0;"><strong>@Model.SchoolYearId</strong></p>
            </div>
            <div>
                <p class="field-label" style="margin-bottom: 0.25rem; font-size: 0.85rem;">Student ID</p>
                <p style="margin: 0;"><strong>@Model.StudentId</strong></p>
            </div>
            <div>
                <p class="field-label" style="margin-bottom: 0.25rem; font-size: 0.85rem;">Student Name</p>
                <p style="margin: 0;"><strong>@(Model.Student != null ? $"{Model.Student.FirstName} {Model.Student.LastName}" : "N/A")</strong></p>
            </div>
            @if (Model.Student != null)
            {
                <div>
                    <p class="field-label" style="margin-bottom: 0.25rem; font-size: 0.85rem;">Grade Level</p>
                    <p style="margin: 0;"><strong>@Model.Student.GradeLevel</strong></p>
                </div>
            }
        </div>
        
        <div class="data-grid" style="margin-bottom: 0.75rem; gap: 0.5rem;">
            <div>
                <p class="field-label" style="margin-bottom: 0.25rem; font-size: 0.85rem;">Sponsor</p>
                <p style="margin: 0;"><strong>@(Model.Sponsor?.SponsorName ?? Model.SponsorId)</strong></p>
            </div>
            <div>
                <p class="field-label" style="margin-bottom: 0.25rem; font-size: 0.85rem;">Status</p>
                <p style="margin: 0;"><span class="status-badge status-@Model.LogStatus.ToLower()">@Model.LogStatus</span></p>
            </div>
            <div>
                <p class="field-label" style="margin-bottom: 0.25rem; font-size: 0.85rem;">Created On</p>
                <p style="margin: 0;">@Model.CreatedOn.ToString("MMM dd, yyyy")</p>
            </div>
        </div>
        
        @if (Model.IsActive)
        {
            <div style="padding: 8px; border-radius: 4px; background: #d1fae5; color: #065f46; margin-bottom: 0.75rem; font-size: 0.9rem;">
                <strong>✓ Active Coverage</strong>
                @if (Model.ActivatedOn.HasValue)
                {
                    <text> - Activated on @Model.ActivatedOn?.ToString("MMM dd, yyyy")</text>
                }
            </div>
        }
        else if (Model.DeactivatedOn.HasValue)
        {
            <div style="padding: 8px; border-radius: 4px; background: #fee2e2; color: #991b1b; margin-bottom: 0.75rem; font-size: 0.9rem;">
                <strong>✕ Deactivated</strong> - @Model.DeactivatedOn?.ToString("MMM dd, yyyy")
                @if (!string.IsNullOrEmpty(Model.DeactivationReason))
                {
                    <text> Reason: @Model.DeactivationReason</text>
                }
            </div>
        }
    </div>
    
    <!-- Coverage Details -->
    <div style="margin-top: 1rem; border-top: 1px solid #e5e7eb; padding-top: 0.75rem;">
        <h3 class="form-section-title" style="margin-bottom: 0.5rem; font-size: 1rem;">Coverage Period and Notes</h3>
        
        <div class="data-grid" style="margin-bottom: 0.5rem; gap: 0.5rem;">
            <div>
                <p class="field-label" style="margin-bottom: 0.25rem; font-size: 0.85rem;">Effective From</p>
                <p style="margin: 0;">@(Model.EffectiveFrom?.ToString("MMM dd, yyyy") ?? "Not specified")</p>
            </div>
            <div>
                <p class="field-label" style="margin-bottom: 0.25rem; font-size: 0.85rem;">Effective To</p>
                <p style="margin: 0;">@(Model.EffectiveTo?.ToString("MMM dd, yyyy") ?? "Not specified")</p>
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div style="margin-bottom: 0.5rem;">
                <label class="field-label" style="font-size: 0.85rem; display: block; margin-bottom: 0.25rem;">Notes</label>
                <div style="padding: 8px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 4px; font-size: 0.9rem;">
                    @Model.Notes
                </div>
            </div>
        }
        
        @if (!string.IsNullOrEmpty(Model.ReviewComments))
        {
            <div style="margin-bottom: 0.5rem;">
                <label class="field-label" style="font-size: 0.85rem; display: block; margin-bottom: 0.25rem;">Review Comments</label>
                <div style="padding: 8px; background: #fef3c7; border: 1px solid #fbbf24; border-radius: 4px; font-size: 0.9rem;">
                    @Model.ReviewComments
                </div>
            </div>
        }
    </div>
    
    <!-- Coverage Rules -->
    <div style="margin-top: 1rem; border-top: 1px solid #e5e7eb; padding-top: 0.75rem;">
        <h3 class="form-section-title" style="margin-bottom: 0.5rem; font-size: 1rem;">Coverage Rules</h3>
        
        @if (Model.CoverageRules != null && Model.CoverageRules.Any())
        {
            <div class="table-wrap" style="font-size: 0.85rem;">
                <table style="font-size: 0.85rem;">
                    <thead>
                        <tr>
                            <th style="padding: 0.5rem;">Target</th>
                            <th style="padding: 0.5rem;">Item/Category</th>
                            <th style="padding: 0.5rem;">Type</th>
                            <th style="padding: 0.5rem;">Coverage</th>
                            <th style="padding: 0.5rem;">Cap</th>
                            <th style="padding: 0.5rem;">Period</th>
                            <th style="padding: 0.5rem;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in Model.CoverageRules.OrderBy(r => r.DisplayOrder))
                        {
                            <tr>
                                <td style="padding: 0.5rem;">
                                    <span class="status-badge" style="font-size: 0.75rem; padding: 2px 6px;">@rule.CoverageTarget</span>
                                </td>
                                <td style="padding: 0.5rem;">
                                    @if (rule.CoverageTarget == "SpecificItem" && rule.Item != null)
                                    {
                                        <strong>@rule.Item.ItemName</strong>
                                        <br />
                                        <small style="color: #666; font-size: 0.75rem;">@rule.Item.ItemId</small>
                                    }
                                    else if (rule.CoverageTarget == "Category" && rule.Category != null)
                                    {
                                        <strong>@rule.Category.CategoryName</strong>
                                    }
                                    else
                                    {
                                        <span style="color: #999;">@(rule.ItemId ?? "N/A")</span>
                                    }
                                </td>
                                <td style="padding: 0.5rem;">
                                    @if (rule.CoverageType == "Percentage")
                                    {
                                        <span>Percentage</span>
                                    }
                                    else if (rule.CoverageType == "FixedAmount")
                                    {
                                        <span>Fixed Amt</span>
                                    }
                                    else
                                    {
                                        <span>@rule.CoverageType</span>
                                    }
                                </td>
                                <td style="padding: 0.5rem;">
                                    @if (rule.CoverageType == "Percentage")
                                    {
                                        <strong>@rule.CoveragePercentage%</strong>
                                    }
                                    else if (rule.CoverageType == "FixedAmount")
                                    {
                                        <strong>@rule.CoverageFixedAmount?.ToString("C")</strong>
                                    }
                                    else
                                    {
                                        <span style="color: #999;">N/A</span>
                                    }
                                </td>
                                <td style="padding: 0.5rem;">
                                    @if (rule.CapAmount.HasValue)
                                    {
                                        @rule.CapAmount.Value.ToString("C")
                                    }
                                    else
                                    {
                                        <span style="color: #999;">No cap</span>
                                    }
                                </td>
                                <td style="padding: 0.5rem;">
                                    @if (rule.EffectiveFrom.HasValue && rule.EffectiveTo.HasValue)
                                    {
                                        <small style="font-size: 0.75rem;">
                                            @rule.EffectiveFrom.Value.ToString("MMM d, yy") - @rule.EffectiveTo.Value.ToString("MMM d, yy")
                                        </small>
                                    }
                                    else if (rule.EffectiveFrom.HasValue)
                                    {
                                        <small style="font-size: 0.75rem;">From @rule.EffectiveFrom.Value.ToString("MMM d, yy")</small>
                                    }
                                    else
                                    {
                                        <span style="color: #999;">-</span>
                                    }
                                </td>
                                <td style="padding: 0.5rem;">
                                    @if (rule.IsActive)
                                    {
                                        <span class="status-badge status-active" style="font-size: 0.75rem; padding: 2px 6px;">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive" style="font-size: 0.75rem; padding: 2px 6px;">Inactive</span>
                                    }
                                </td>
                            </tr>
                            @if (!string.IsNullOrWhiteSpace(rule.ExceptionNote))
                            {
                                <tr>
                                    <td colspan="7" style="background-color: #f8f9fa; padding: 0.25rem 0.5rem; border-left: 3px solid #ffc107; font-size: 0.8rem;">
                                        <strong>Note:</strong> @rule.ExceptionNote
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 1rem; text-align: center; color: #666; background: #f9fafb; border-radius: 4px; border: 1px solid #e5e7eb; font-size: 0.9rem;">
                <p style="margin: 0;">No coverage rules defined yet.</p>
            </div>
        }
    </div>
    
    <!-- Attachment -->
    <div style="margin-top: 1rem; border-top: 1px solid #e5e7eb; padding-top: 0.75rem;">
        <h3 class="form-section-title" style="margin-bottom: 0.5rem; font-size: 1rem;">Document Attachment</h3>
        
        @if (!string.IsNullOrEmpty(Model.AttachmentFileName))
        {
            <div style="padding: 8px; background: #d1fae5; color: #065f46; border-radius: 4px; font-size: 0.9rem;">
                <strong>Attachment:</strong> <span style="font-family: monospace;">@Model.AttachmentFileName</span>
                @if (Model.AttachmentUploadedOn.HasValue)
                {
                    <text> (Uploaded: @Model.AttachmentUploadedOn?.ToString("MMM dd, yyyy"))</text>
                }
                <a href="@Url.Action("DownloadAttachment", "Portal", new { id = Model.LogId })" 
                   class="btn-primary" 
                   style="margin-left: 8px; padding: 4px 12px; font-size: 0.85rem; display: inline-block;">
                    Download Attachment
                </a>
            </div>
        }
        else
        {
            <div style="padding: 1rem; text-align: center; color: #666; background: #f9fafb; border-radius: 4px; border: 1px solid #e5e7eb; font-size: 0.9rem;">
                <p style="margin: 0;">No attachment uploaded.</p>
            </div>
        }
    </div>
    
    <!-- Close Button -->
    <div style="display: flex; justify-content: flex-end; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid #e5e7eb;">
        <button type="button" class="btn-secondary" onclick="closeDetailsModal()">
            Close
        </button>
    </div>
</div>
