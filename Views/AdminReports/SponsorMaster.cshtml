@model ISMSponsor.ViewModels.SponsorMasterReportViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sponsor Master Report";
}

<div class="page-header">
    <div class="page-header-actions">
        <div>
            <h1>Sponsor Master Report</h1>
            <p class="page-subtitle">Complete sponsor roster with activity metrics, merge history, and sync status</p>
        </div>
        <div style="display: flex; gap: 12px;">
            <a href="/Settings/Reports" class="btn-secondary">← Back to Reports</a>
            <a href="?exportFormat=csv&status=@Model.Filters.Status&startDate=@Model.Filters.StartDate&endDate=@Model.Filters.EndDate" class="btn-primary btn-add">Export CSV</a>
        </div>
    </div>
</div>

<!-- Summary Statistics -->
<div class="stat-grid" style="margin-bottom: 1.5rem;">
    <div class="stat-card">
        <div class="stat-label">Total Sponsors</div>
        <div class="stat-value">@Model.TotalSponsors</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Active Sponsors</div>
        <div class="stat-value">@Model.ActiveSponsors</div>
        <div class="stat-footer">@((Model.TotalSponsors > 0 ? (Model.ActiveSponsors * 100.0 / Model.TotalSponsors) : 0).ToString("F1"))% of total</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Inactive Sponsors</div>
        <div class="stat-value">@Model.InactiveSponsors</div>
        <div class="stat-footer">@((Model.TotalSponsors > 0 ? (Model.InactiveSponsors * 100.0 / Model.TotalSponsors) : 0).ToString("F1"))% of total</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Report Generated</div>
        <div class="stat-value">@Model.GeneratedAt.ToString("MMM d, yyyy")</div>
        <div class="stat-footer">@Model.GeneratedAt.ToString("h:mm tt")</div>
    </div>
</div>

<!-- Report Filters -->
<div class="card">
    <form method="get" asp-action="SponsorMaster" asp-controller="AdminReports" class="filter-form">
        <div class="filter-group" style="flex: 1; min-width: 180px;">
            <label class="field-label">Status</label>
            <select name="Status">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(Model.Filters.Status == "Active")">Active</option>
                <option value="Inactive" selected="@(Model.Filters.Status == "Inactive")">Inactive</option>
            </select>
        </div>
        <div class="filter-group" style="flex: 1; min-width: 200px;">
            <label class="field-label">Start Date</label>
            <input type="date" name="StartDate" value="@Model.Filters.StartDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="filter-group" style="flex: 1; min-width: 200px;">
            <label class="field-label">End Date</label>
            <input type="date" name="EndDate" value="@Model.Filters.EndDate?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn-secondary">Apply Filters</button>
        <a href="@Url.Action("SponsorMaster", "AdminReports")" class="btn-secondary">Clear</a>
    </form>
</div>

<!-- Sponsor Master Table -->
<div class="card">
    <h2 class="table-title">Sponsor Records (@Model.SponsorDetails.Count)</h2>
    
    @if (Model.SponsorDetails.Any())
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Sponsor ID</th>
                        <th>Sponsor Name</th>
                        <th>Legal Name</th>
                        <th>Students</th>
                        <th>Active LoGs</th>
                        <th>Status</th>
                        <th>Synced</th>
                        <th>Created</th>
                        <th>Modified</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sponsor in Model.SponsorDetails.OrderBy(s => s.SponsorName))
                    {
                        <tr class="@(sponsor.IsActive ? "" : "inactive-row")" style="@(sponsor.IsActive ? "" : "opacity: 0.7;")">
                            <td data-label="Sponsor ID"><strong>@sponsor.SponsorId</strong></td>
                            <td data-label="Sponsor Name">@sponsor.SponsorName</td>
                            <td data-label="Legal Name" style="color: #666; font-size: 0.9rem;">@(sponsor.LegalName ?? "—")</td>
                            <td data-label="Students">@sponsor.StudentCount</td>
                            <td data-label="Active LoGs">@sponsor.ActiveLogCount</td>
                            <td data-label="Status">
                                @if (sponsor.IsActive)
                                {
                                    <span class="status-badge status-active">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">Inactive</span>
                                }
                            </td>
                            <td data-label="Synced">
                                @if (sponsor.IsSynced)
                                {
                                    <span class="status-badge status-success">Synced</span>
                                }
                                else
                                {
                                    <span class="status-badge status-warning">Not Synced</span>
                                }
                            </td>
                            <td data-label="Created">@sponsor.CreatedOn.ToString("MMM d, yyyy")</td>
                            <td data-label="Modified">@(sponsor.ModifiedOn?.ToString("MMM d, yyyy") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="table-wrap">
            @{
                ViewData["EmptyIcon"] = "📊";
                ViewData["EmptyTitle"] = "No sponsors found";
                ViewData["EmptyMessage"] = "No sponsors match the selected filters. Try adjusting your filter criteria.";
            }
            @await Html.PartialAsync("_EmptyState")
        </div>
    }
</div>
